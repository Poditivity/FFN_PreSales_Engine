# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mail (used by the send-mail Edge Function, set as Supabase Function secrets)
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_HOST=
FROM_ADDRESS=
FROM_NAME=
SENDING_DOMAIN=
# Optional: where replies to system emails go.
REPLY_TO_ADDRESS=

# WhatsApp Business Cloud API (Meta) — Supabase Function secrets, never NEXT_PUBLIC_.
# Leave the first two unset to keep notifications email-only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: Graph API version (default v25.0), approved template language (default en),
# and a country calling code for numbers stored without one (e.g. 91). No default country.
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_DEFAULT_COUNTRY_CODE=

# Settings page usage meters (server-side, optional). Limits default to the free plans: Supabase
# 0.5 GB database and 1 GB file storage, R2 10 GB. Set these only if the plan changes.
SUPABASE_DATABASE_LIMIT_GB=
SUPABASE_STORAGE_LIMIT_GB=

# Cloudflare R2 uploads: staff images (r2-presign), applicant files on forms
# (form-upload-presign) and the usage figure on Settings (r2-usage). Set as Supabase Function secrets.
# Create an R2 API token with Object Read & Write on the one bucket. R2_PUBLIC_BASE_URL is the
# address the bucket is served from (custom domain, or the r2.dev address), with no trailing path.
# The bucket also needs a CORS rule that allows PUT with Content-Type and Cache-Control headers
# from the app's origin.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Optional: overrides the 10 GB R2 free-tier limit shown on Settings.
R2_STORAGE_LIMIT_GB=

# Alerts and summaries (escalation-check, digest-dispatch; Supabase Function secrets).
# The address of an incoming webhook on the Google Chat space the team reads. It carries a
# key and token, so it is a secret: never NEXT_PUBLIC_, never in the database. Leave it unset
# to send email only.
GOOGLE_CHAT_WEBHOOK_URL=
# The public address of this app, for the links in alerts and summaries (no trailing slash).
# Without it the messages carry no links.
SITE_URL=
